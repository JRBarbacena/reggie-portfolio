# Browser-safe values. For local Vite development, copy only these two lines
# into react-app/.env.local. VITE_ values are bundled into public JavaScript.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only Vercel Function values. Configure these in Vercel, never with a
# VITE_ prefix and never in react-app/.env.local.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
CHAT_NOTIFICATION_EMAIL=
CHAT_NOTIFICATION_FROM=
SITE_URL=https://example.com
