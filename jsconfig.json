{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2022",
    "types": ["node", "vite/client"]
  },
  "include": [
    "api/**/*.js",
    "server/**/*.js",
    "react-app/src/lib/**/*.js",
    "react-app/src/responsive-photos.js",
    "react.vite.config.js",
    "vitest.config.js"
  ]
}
