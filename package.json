{
  "name": "reggie-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "React developer portfolio with a Supabase-managed private content dashboard.",
  "type": "module",
  "scripts": {
    "build": "npm run build:react",
    "vercel-build": "npm run build:react",
    "test": "vitest --run",
    "test:unit": "vitest --run",
    "preview": "vite preview --config react.vite.config.js",
    "dev:react": "vite --config react.vite.config.js",
    "build:react": "vite build --config react.vite.config.js",
    "verify": "npm run test:unit && npm run build:react",
    "qa": "npm run verify"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.2.2",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.112.4",
    "animejs": "^4.5.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "simple-icons": "^16.29.0",
    "three": "0.185.1"
  },
  "overrides": {
    "fast-uri": "3.1.6"
  }
}
