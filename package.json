{
  "name": "reggie-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "React developer portfolio with a Supabase-managed private content dashboard.",
  "type": "module",
  "scripts": {
    "build": "npm run build:react",
    "vercel-build": "npm run build:react",
    "test": "vitest --run",
    "test:unit": "vitest --run",
    "preview": "vite preview --config react.vite.config.js",
    "dev:react": "vite --config react.vite.config.js",
    "build:react": "vite build --config react.vite.config.js",
    "generate": "node scripts/generate-site.mjs",
    "generate:check": "node scripts/generate-site.mjs --check",
    "test:routes": "node scripts/test-routes.mjs",
    "qa:origins": "node scripts/qa-external-origins.mjs",
    "qa:encoding": "node scripts/qa-encoding.mjs",
    "qa:readiness": "node scripts/content-readiness.mjs",
    "qa:static": "node scripts/qa-static.mjs",
    "qa:responsive": "node scripts/qa-responsive.mjs",
    "verify": "npm run generate:check && npm run qa:encoding && npm run test:unit && npm run build:react && npm run test:routes",
    "qa": "npm run verify"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "8.20.0",
    "fast-check": "3.23.2",
    "jsdom": "24.1.3",
    "vite": "^8.2.2",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.112.4",
    "animejs": "^4.5.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "simple-icons": "^16.29.0",
    "three": "0.185.1"
  },
  "overrides": {
    "fast-uri": "3.1.6"
  }
}
