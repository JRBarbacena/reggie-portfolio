{
  "name": "reggie-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "React developer portfolio with a Supabase-managed private content dashboard.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "npm run build:react",
    "vercel-build": "npm run build:react",
    "test": "vitest --run",
    "test:unit": "vitest --run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "preview": "vite preview --config react.vite.config.js",
    "dev:react": "vite --config react.vite.config.js",
    "build:react": "vite build --config react.vite.config.js",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run build:react",
    "qa": "npm run verify"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.112.4",
    "@vercel/functions": "3.9.11",
    "animejs": "^4.5.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "simple-icons": "^16.34.0",
    "three": "0.185.1"
  },
  "overrides": {
    "fast-uri": "3.1.6",
    "source-map-js": "1.2.2"
  }
}
